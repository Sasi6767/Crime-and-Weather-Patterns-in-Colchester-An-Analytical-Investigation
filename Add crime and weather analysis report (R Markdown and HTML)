  mutate(
    lat_round = round(lat, 3),
    long_round = round(long, 3)
  ) %>%
  group_by(lat_round, long_round) %>%
  summarise(density = n(), .groups = 'drop')

# Define color palette for categories
category_colors <- leaflet::colorFactor(
  palette = c("#E74C3C", "#3498DB", "#2ECC71", "#F39C12", "#9B59B6",
              "#1ABC9C", "#34495E", "#E67E22", "#95A5A6", "#D35400",
              "#C0392B", "#2980B9", "#27AE60", "#F1C40F", "#8E44AD"),
  domain = unique(map_data$category_clean)
)

# Generate map
crime_map <- leaflet(map_data, width = "100%", height = "400px") %>%
  addProviderTiles(providers$CartoDB.Positron, group = "Light") %>%
  addProviderTiles(providers$CartoDB.DarkMatter, group = "Dark") %>%
  addProviderTiles(providers$Esri.WorldImagery, group = "Satellite") %>%
  setView(lng = mean(map_data$long), lat = mean(map_data$lat), zoom = 12) %>%

  # Add heatmap
  addHeatmap(
    data = crime_density,
    lng = ~long_round,
    lat = ~lat_round,
    intensity = ~density,
    blur = 25,
    radius = 20,
    max = max(crime_density$density),
    group = "Heatmap"
  ) %>%

  # Add circle markers
  addCircleMarkers(
    lng = ~long,
    lat = ~lat,
    radius = 4,
    color = ~category_colors(category_clean),
