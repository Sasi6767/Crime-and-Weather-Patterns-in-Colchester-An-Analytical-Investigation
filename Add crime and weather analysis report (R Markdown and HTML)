# Crime-Weather Integration Analysis

```{r crime-weather-merge}
# Step 1: Add 'month' column to both datasets
crime_data <- crime_data %>%
  mutate(month = format(as.Date(paste0(date, "-01")), "%Y-%m"))

temp_monthly <- temp_current %>%
  mutate(month = format(Date, "%Y-%m")) %>%
  group_by(month) %>%
  summarise(
    avg_temp = mean(TemperatureCAvg, na.rm = TRUE),
    max_temp = mean(TemperatureCMax, na.rm = TRUE),
    total_rain = sum(Precmm, na.rm = TRUE),
    rainy_days = sum(Precmm > 0.1, na.rm = TRUE),
    dry_days = sum(Precmm <= 0.1, na.rm = TRUE),
    mean_precip = mean(Precmm, na.rm = TRUE),
    is_rainy = mean(Precmm > 0.1, na.rm = TRUE) > 0.5,
    .groups = "drop"
  )

# Step 2: Aggregate crime data by month
crime_monthly <- crime_data %>%
  group_by(month) %>%
  summarise(
    total_crimes = n(),
    violent_crimes = sum(grepl("violen|assault|robbery|weapon", category, ignore.case = TRUE)),
    property_crimes = sum(grepl("burglary|criminal damage|arson", category, ignore.case = TRUE)),
    theft_crimes = sum(grepl("theft|shoplifting", category, ignore.case = TRUE)),
    vehicle_crimes = sum(grepl("vehicle", category, ignore.case = TRUE)),
    .groups = 'drop'
  )

# Step 3: Merge on month
crime_weather <- left_join(crime_monthly, temp_monthly, by = "month") %>%
  filter(complete.cases(.)) %>%
  mutate(
    crime_rate = total_crimes / mean(total_crimes, na.rm = TRUE) * 100,
    is_high_crime = total_crimes > quantile(total_crimes, 0.75, na.rm = TRUE)
  )

# Step 4: Generate summary table
if (nrow(crime_weather) > 0) {
  merge_summary <- data.frame(
    Metric = c("Months with Data", "Average Monthly Crimes", "Correlation (Temp-Crime)",
               "High Crime Months", "Rainy Month Crime Reduction"),
    Value = c(
      nrow(crime_weather),
      round(mean(crime_weather$total_crimes, na.rm = TRUE), 1),
      round(cor(crime_weather$avg_temp, crime_weather$total_crimes, use = "complete.obs"), 3),
      sum(crime_weather$is_high_crime, na.rm = TRUE),
      {
        dry_mean <- mean(crime_weather$total_crimes[!crime_weather$is_rainy], na.rm = TRUE)
        wet_mean <- mean(crime_weather$total_crimes[crime_weather$is_rainy], na.rm = TRUE)
        if (!is.na(dry_mean) && dry_mean > 0) {
          paste0(round((1 - wet_mean / dry_mean) * 100, 1), "%")
        } else {
          "N/A"
        }
      }
    )
  )

  merge_summary %>%
    kable("html", escape = FALSE, align = c('l', 'r'),
          caption = "<b style='font-size:18px;'>Crime-Weather Analysis Summary</b>") %>%
    kable_styling(bootstrap_options = c("striped", "hover"),
                  full_width = FALSE, position = "center") %>%
    row_spec(0, bold = TRUE, color = "white", background = "#9B59B6") %>%
    column_spec(1, bold = TRUE, width = "250px") %>%
    column_spec(2, width = "150px")
} else {
  htmltools::div(style = "color: red; font-weight: bold;",
                 "⚠ No joined data available. Check if month columns matched correctly.")
}
```
Bringing together monthly crime stats and weather patterns gave us a clearer view of how the two interact in Colchester. By lining up crime counts with average temperatures, rainfall, and the number of rainy days, we started seeing some interesting trends—like crime tending to dip when it’s wetter and rise when the weather heats up. The summary table pulls all this together in one place, making it easier to spot these patterns and understand how changes in the environment might influence public safety throughout the year.


