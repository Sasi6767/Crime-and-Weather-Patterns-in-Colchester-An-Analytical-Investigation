## Temporal Crime Patterns

```{r temporal-monthly, fig.width=8, fig.height=5}
# Define season colors
season_colors <- c("Spring" = "#1ABC9C", "Summer" = "#F39C12",
                   "Autumn" = "#E74C3C", "Winter" = "#3498DB")

# Step 1: Summarize monthly stats from crime_data
monthly_analysis <- crime_data %>%
  group_by(month, month_num, season) %>%
  summarise(
    total_crimes = n(),
    violent_crimes = sum(grepl("violen|assault|robbery", category, ignore.case = TRUE)),
    theft_crimes = sum(grepl("theft|burglary|shoplifting", category, ignore.case = TRUE)),
    weekend_crimes = sum(is_weekend),
    .groups = 'drop'
  ) %>%
  arrange(month_num) %>%
  mutate(
    pct_change = round((total_crimes - lag(total_crimes)) / lag(total_crimes) * 100, 1),
    violent_pct = round(violent_crimes / total_crimes * 100, 1),
    theft_pct = round(theft_crimes / total_crimes * 100, 1)
  )

# Step 2: Calculate overall monthly average
monthly_avg <- mean(monthly_analysis$total_crimes)

# Step 3: Create the vibrant monthly plot
p3 <- plot_ly() %>%
  add_bars(
    data = monthly_analysis,
    x = ~month,
    y = ~total_crimes,
    name = 'Total Crimes',
    marker = list(
      color = ~season_colors[season],
      line = list(color = 'black', width = 1)
    ),
    text = ~paste('<b>', month, ' (', season, ')</b><br>',
                  'Total crimes: ', format(total_crimes, big.mark = ','), '<br>',
                  'Change from prev: ', ifelse(is.na(pct_change), "N/A",
                                             paste0(ifelse(pct_change > 0, '+', ''), pct_change, '%')), '<br>',
                  'Violent crimes: ', violent_crimes, ' (', violent_pct, '%)<br>',
                  'Theft crimes: ', theft_crimes, ' (', theft_pct, '%)'),
    hoverinfo = 'text',
    hoverlabel = list(
      bgcolor = "white",
      font = list(size = 14),
      bordercolor = "black"
    )
  ) %>%
  add_lines(
    x = monthly_analysis$month,
    y = rep(monthly_avg, nrow(monthly_analysis)),
    name = 'Monthly Average',
    line = list(color = '#E74C3C', width = 3, dash = 'dash'),
    hoverinfo = 'skip'
  ) %>%
  add_annotations(
  x = monthly_analysis$month,
  y = monthly_analysis$total_crimes + 50,
  text = ~ifelse(!is.na(pct_change),
                paste0(ifelse(pct_change > 0, '▲', '▼'), ' ', abs(pct_change), '%'),
                ''),
  showarrow = FALSE,
  font = list(
    size = 13,
    color = "black",
    family = "Arial"
  )
)%>%
  layout(
  title = list(
    text = "<b>Monthly Crime Trends with Seasonal Patterns</b><br><span style='color:gray; font-size:14px;'>Arrows show month-over-month change</span>",
    font = list(size = 20),
    y = 0.95,
