# Data Preprocessing and Feature Engineering

```{r data-preprocessing}
# Process crime data with features
crime_data <- crime_data %>%
  mutate(
    #  date format (original format: YYYY-MM)
    date = as.Date(paste0(date, "-01")),
    lat = as.numeric(gsub(",", "", lat)),
    long = as.numeric(gsub(",", "", long)),
    # Create temporal features
    year = year(date),
    month = factor(month(date, label = TRUE, abbr = TRUE), levels = month.abb),
    month_num = month(date),
    week_of_year = week(date),
    day_of_week = factor(wday(date, label = TRUE, abbr = FALSE),
                         levels = c("Monday", "Tuesday", "Wednesday", "Thursday",
                                    "Friday", "Saturday", "Sunday")),
    day_of_month = day(date),
    is_weekend = day_of_week %in% c("Saturday", "Sunday"),
    is_month_start = day_of_month <= 7,
    is_month_end = day_of_month >= 24,
    # Seasonal classification
    season = factor(case_when(
      month_num %in% c(12, 1, 2) ~ "Winter",
      month_num %in% c(3, 4, 5) ~ "Spring",
      month_num %in% c(6, 7, 8) ~ "Summer",
      month_num %in% c(9, 10, 11) ~ "Autumn"
    ), levels = c("Spring", "Summer", "Autumn", "Winter")),
    # Clean crime categories
    category_clean = str_to_title(str_replace_all(category, "-", " "))
  ) %>%
  filter(!is.na(date), !is.na(lat), !is.na(long)) %>%
  filter(lat > 50 & lat < 54, long > -2 & long < 2)  # Safe UK bounds

# Process weather data with advanced features
process_weather <- function(df, year_label) {
  df %>%
    mutate(
      Date = as.Date(Date),
      year_label = year_label,
      month = factor(month(Date, label = TRUE, abbr = TRUE), levels = month.abb),
      month_num = month(Date),
      week_of_year = week(Date),
      day_of_week = wday(Date, label = TRUE, abbr = FALSE),
      # Weather categorizations
      temp_category = cut(TemperatureCAvg,
                          breaks = c(-Inf, 0, 5, 10, 15, 20, 25, Inf),
                          labels = c("Freezing", "Very Cold", "Cold", "Cool",
                                     "Mild", "Warm", "Hot")),
      precip_category = cut(Precmm,
                            breaks = c(-0.1, 0.1, 1, 5, 10, 25, Inf),
                            labels = c("Dry", "Light", "Moderate", "Heavy",
                                       "Very Heavy", "Extreme")),
      wind_category = cut(WindkmhInt,
                          breaks = c(-Inf, 10, 20, 30, 40, Inf),
                          labels = c("Calm", "Light", "Moderate", "Strong", "Gale")),
      temp_range = TemperatureCMax - TemperatureCMin,
      is_rainy = Precmm > 0.1,
      is_windy = WindkmhInt > 20,
      is_cold = TemperatureCAvg < 10,
      is_hot = TemperatureCAvg > 20,
      comfort_index = scale(TemperatureCAvg) * 0.4 +
                      scale(-abs(TemperatureCAvg - 18)) * 0.3 +
                      scale(-Precmm) * 0.2 +
                      scale(-WindkmhInt) * 0.1,
      season = factor(case_when(
        month_num %in% c(12, 1, 2) ~ "Winter",
        month_num %in% c(3, 4, 5) ~ "Spring",
        month_num %in% c(6, 7, 8) ~ "Summer",
        month_num %in% c(9, 10, 11) ~ "Autumn"
      ), levels = c("Spring", "Summer", "Autumn", "Winter"))
    ) %>%
    filter(!is.na(Date))
}

# Apply to both weather datasets
temp_current <- process_weather(temp_current, "2024-25")
temp_previous <- process_weather(temp_previous, "2023-24")

# Create processing summary
